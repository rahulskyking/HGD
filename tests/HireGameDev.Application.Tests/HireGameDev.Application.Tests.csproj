<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <!-- Handler tests run against the real ApplicationDbContext on an in-memory SQLite database (ADR-016). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.20" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HireGameDev.Application\HireGameDev.Application.csproj" />
    <!-- Only for the SQLite-backed ApplicationDbContext and the skill seeder; tests never call Infrastructure services directly. -->
    <ProjectReference Include="..\..\src\HireGameDev.Infrastructure\HireGameDev.Infrastructure.csproj" />
  </ItemGroup>

</Project>
