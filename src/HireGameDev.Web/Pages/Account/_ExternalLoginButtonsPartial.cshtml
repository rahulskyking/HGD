@using Microsoft.AspNetCore.Authentication
@inject IAuthenticationSchemeProvider SchemeProvider
@model ExternalLoginButtons
@{
    // External providers are the schemes with a display name (cookie schemes have none).
    var providers = (await SchemeProvider.GetAllSchemesAsync())
        .Where(x => !string.IsNullOrEmpty(x.DisplayName))
        .ToList();
}

@if (providers.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        No sign-in provider is configured. Add Google or GitHub credentials — see <code>docs/README.md</code>.
    </div>
}
else
{
    <form method="post" asp-page="./ExternalLogin" asp-route-role="@Model.Role" asp-route-returnUrl="@Model.ReturnUrl">
        @foreach (var provider in providers)
        {
            <button type="submit" class="btn btn-outline-dark btn-lg w-100 mb-2" name="provider" value="@provider.Name">
                Continue with @provider.DisplayName
            </button>
        }
    </form>
}
