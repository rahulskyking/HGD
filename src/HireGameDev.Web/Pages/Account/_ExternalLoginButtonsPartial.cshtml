@using Microsoft.AspNetCore.Authentication
@inject IAuthenticationSchemeProvider SchemeProvider
@model string?
@{
    // External providers are the schemes with a display name (cookies have none).
    var providers = (await SchemeProvider.GetAllSchemesAsync())
        .Where(x => !string.IsNullOrEmpty(x.DisplayName))
        .ToList();
}

@if (providers.Count > 0)
{
    <div class="text-center text-muted my-3">or</div>

    <form method="post" asp-page="./ExternalLogin" asp-route-returnUrl="@Model">
        @foreach (var provider in providers)
        {
            <button type="submit" class="btn btn-outline-dark w-100 mb-2" name="provider" value="@provider.Name">
                Continue with @provider.DisplayName
            </button>
        }
    </form>
}
