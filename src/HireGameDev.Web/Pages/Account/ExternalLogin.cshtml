@page
@using HireGameDev.Domain.Enums
@model ExternalLoginModel
@{
    ViewData["Title"] = "One last thing";
}

@*
    Shown only when someone new used the plain "Sign in" buttons (no role chosen yet).
    Sign-up from the landing page carries the role and never lands here.
*@
<div class="container">
    <div class="hgd-auth">
        <div class="card hgd-elevated">
            <div class="card-body">
                <h1 class="h3 mb-3">@ViewData["Title"]</h1>

                <p class="text-secondary">
                    You've signed in with <strong>@Model.ProviderDisplayName</strong> as <strong>@Model.Email</strong>,
                    but there's no HireGameDev account for it yet. Tell us who you are and we'll create one.
                </p>

                <form method="post" asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <input type="hidden" asp-for="ProviderDisplayName" />
                    <input type="hidden" asp-for="Email" />

                    <fieldset class="mb-3">
                        <legend class="form-label fs-6">I am a</legend>
                        <div class="d-grid gap-2">
                            <label class="hgd-choice">
                                <input class="form-check-input" type="radio" asp-for="Input.Role" value="@UserRole.Candidate" id="roleCandidate" />
                                <span>
                                    <strong class="d-block">Game developer</strong>
                                    <span class="text-secondary small">Looking for work</span>
                                </span>
                            </label>
                            <label class="hgd-choice">
                                <input class="form-check-input" type="radio" asp-for="Input.Role" value="@UserRole.Studio" id="roleStudio" />
                                <span>
                                    <strong class="d-block">Studio</strong>
                                    <span class="text-secondary small">Hiring</span>
                                </span>
                            </label>
                        </div>
                        <span asp-validation-for="Input.Role" class="text-danger d-block mt-2"></span>
                    </fieldset>

                    <p class="form-text">
                        By continuing you confirm that you are 18 or older and agree to the Terms of Service and
                        <a asp-page="/Privacy">Privacy Policy</a>.
                    </p>

                    <button type="submit" class="btn btn-primary btn-lg w-100">Create my account</button>
                </form>

                <p class="mt-4 mb-0 text-center small">
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-secondary">Cancel</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
