@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = Model.Succeeded ? "Email confirmed" : "Confirmation failed";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5 text-center">
        <h1 class="h3 mb-3">@ViewData["Title"]</h1>

        @if (Model.Succeeded)
        {
            <p>Thanks for confirming your email. Your account is ready.</p>
            <a class="btn btn-primary" asp-page="./Login">Sign in</a>
        }
        else
        {
            <div class="alert alert-danger" role="alert">
                @foreach (var error in Model.Errors)
                {
                    <div>@error</div>
                }
            </div>
            <p class="text-muted">
                The link may have expired or already been used.
                <a asp-page="./ResendEmailConfirmation">Request a new confirmation email</a>.
            </p>
        }
    </div>
</div>
