@page
@using HireGameDev.Domain.Enums
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-4">Use the account you joined with.</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        }

        <partial name="_ExternalLoginButtonsPartial" model="new ExternalLoginButtons(null, Model.ReturnUrl)" />

        <p class="mt-4 text-center small">
            New to HireGameDev?
            <a asp-page="./SignUp" asp-route-role="@UserRole.Candidate" asp-route-returnUrl="@Model.ReturnUrl">Join as a game developer</a>
            or <a asp-page="./SignUp" asp-route-role="@UserRole.Studio" asp-route-returnUrl="@Model.ReturnUrl">as a studio</a>.
        </p>
    </div>
</div>
