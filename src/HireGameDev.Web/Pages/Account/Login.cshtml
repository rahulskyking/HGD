@page
@using HireGameDev.Domain.Enums
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="container">
    <div class="hgd-auth">
        <div class="card hgd-elevated">
            <div class="card-body">
                <div class="text-center mb-4">
                    <span class="hgd-brand-mark hgd-brand-mark-lg mb-3" aria-hidden="true">
                        <svg><use href="#hgd-icon-logo" /></svg>
                    </span>
                    <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                    <p class="text-secondary mb-0">Use the account you joined with.</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                }

                <partial name="_ExternalLoginButtonsPartial" model="new ExternalLoginButtons(null, Model.ReturnUrl)" />

                <p class="mt-4 mb-0 text-center small text-secondary">
                    New to HireGameDev?
                    <a asp-page="./SignUp" asp-route-role="@UserRole.Candidate" asp-route-returnUrl="@Model.ReturnUrl">Join as a game developer</a>
                    or <a asp-page="./SignUp" asp-route-role="@UserRole.Studio" asp-route-returnUrl="@Model.ReturnUrl">as a studio</a>.
                </p>
            </div>
        </div>
    </div>
</div>
