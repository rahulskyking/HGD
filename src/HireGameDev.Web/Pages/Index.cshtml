@page
@model IndexModel
@{
    ViewData["Title"] = "Game industry hiring, built for India";
}

<section class="text-center py-5">
    <div class="col-lg-8 mx-auto">
        <h1 class="display-5 fw-bold">Game industry hiring, built for India</h1>
        <p class="lead text-muted">
            Studios post roles with real salary ranges. Developers show real shipped work.
            Everyone can see where their application stands.
        </p>
    </div>
</section>

<partial name="_JoinOptionsPartial" />

<p class="text-center mt-4">
    Already have an account? <a asp-page="/Account/Login">Sign in</a>
</p>
