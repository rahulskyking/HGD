@using HireGameDev.Domain.Enums
<ul class="navbar-nav align-items-md-center gap-md-1 py-2 py-md-0">
@if (User.Identity?.IsAuthenticated == true)
{
    @if (User.HomePage() is { } home)
    {
        <li class="nav-item">
            <a class="nav-link d-flex align-items-center gap-2" asp-page="@home">
                <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-grid" /></svg> Dashboard
            </a>
        </li>
    }
    @if (User.IsInRole(UserRole.Candidate))
    {
        <li class="nav-item">
            <a class="nav-link d-flex align-items-center gap-2" asp-page="/Candidate/Profile/Index">
                <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-user" /></svg> My profile
            </a>
        </li>
    }
    @if (User.IsInRole(UserRole.Studio))
    {
        <li class="nav-item">
            <a class="nav-link d-flex align-items-center gap-2" asp-page="/Studio/Profile/Index">
                <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-briefcase" /></svg> Studio profile
            </a>
        </li>
    }
    <li class="nav-item">
        <span class="nav-link text-secondary text-truncate" style="max-width: 16rem" title="@User.Identity.Name">@User.Identity.Name</span>
    </li>
    <li class="nav-item">
        <form asp-page="/Account/Logout" method="post">
            <button type="submit" class="btn btn-outline-secondary btn-sm ms-md-2 d-inline-flex align-items-center gap-2">
                <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-log-out" /></svg> Sign out
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-page="/Account/Login">Sign in</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm ms-md-2" asp-page="/Account/SignUp">Get started</a>
    </li>
}
</ul>
