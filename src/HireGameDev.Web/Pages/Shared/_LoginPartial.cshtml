<ul class="navbar-nav">
@if (User.Identity?.IsAuthenticated == true)
{
    <li class="nav-item">
        <span class="nav-link text-dark">@User.Identity.Name</span>
    </li>
    <li class="nav-item">
        <form asp-page="/Account/Logout" method="post">
            <button type="submit" class="nav-link btn btn-link text-dark">Sign out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-page="/Account/Login">Sign in</a>
    </li>
}
</ul>
