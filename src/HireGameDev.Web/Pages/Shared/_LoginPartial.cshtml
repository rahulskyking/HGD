<ul class="navbar-nav align-items-sm-center">
@if (User.Identity?.IsAuthenticated == true)
{
    @if (User.HomePage() is { } home)
    {
        <li class="nav-item">
            <a class="nav-link" asp-page="@home">Dashboard</a>
        </li>
    }
    <li class="nav-item">
        <span class="nav-link text-muted">@User.Identity.Name</span>
    </li>
    <li class="nav-item">
        <form asp-page="/Account/Logout" method="post">
            <button type="submit" class="btn btn-link nav-link">Sign out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-page="/Account/Login">Sign in</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm ms-sm-2" asp-page="/Account/SignUp">Get started</a>
    </li>
}
</ul>
