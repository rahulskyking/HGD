@using HireGameDev.Domain.Enums
@*
    The two ways into the product. Used by the landing page and by /Account/SignUp
    when no role was chosen yet.
*@
<div class="row g-4 justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card h-100 text-center">
            <div class="card-body d-flex flex-column p-4">
                <h2 class="h4">I'm a game developer</h2>
                <p class="text-muted flex-grow-1">
                    Programmers, artists, designers, QA, producers, audio — show your shipped work
                    and find studios that pay fairly.
                </p>
                <a class="btn btn-primary" asp-page="/Account/SignUp" asp-route-role="@UserRole.Candidate">Find game jobs</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-5">
        <div class="card h-100 text-center">
            <div class="card-body d-flex flex-column p-4">
                <h2 class="h4">I'm a studio</h2>
                <p class="text-muted flex-grow-1">
                    Post roles with salary ranges, see ranked applicants and hire from India's game talent pool.
                </p>
                <a class="btn btn-outline-primary" asp-page="/Account/SignUp" asp-route-role="@UserRole.Studio">Hire game talent</a>
            </div>
        </div>
    </div>
</div>
