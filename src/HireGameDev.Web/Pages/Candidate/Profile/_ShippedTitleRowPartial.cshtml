@using HireGameDev.Domain.Entities
@model ShippedTitleInput
@*
    One repeater row. Rendered with `for="Input.ShippedTitles[i]"` for saved rows and once more
    as the <template> with the prefix `Input.ShippedTitles[__index__]`, which js/forms.js fills in.
*@
<div class="hgd-repeater-row" data-hgd-repeater-row>
    <div class="row g-3 flex-grow-1">
        <div class="col-md-4">
            <label asp-for="GameName" class="form-label"></label>
            <input asp-for="GameName" class="form-control" placeholder="Raji: An Ancient Epic" />
            <span asp-validation-for="GameName" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="StudioName" class="form-label"></label>
            <input asp-for="StudioName" class="form-control" placeholder="Nodding Heads Games" />
            <span asp-validation-for="StudioName" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Role" class="form-label"></label>
            <input asp-for="Role" class="form-control" placeholder="Gameplay programmer" />
            <span asp-validation-for="Role" class="text-danger small"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Year" class="form-label"></label>
            <input asp-for="Year" class="form-control" type="number" inputmode="numeric"
                   min="@ShippedTitle.EarliestYear" max="@ShippedTitle.LatestYear()" />
            <span asp-validation-for="Year" class="text-danger small"></span>
        </div>
    </div>
    <button type="button" class="btn hgd-icon-btn" data-hgd-repeater-remove aria-label="Remove this title" title="Remove">
        <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-trash-2" /></svg>
    </button>
</div>
