@page
@model StyleguideModel
@{
    ViewData["Title"] = "Style guide";
}

@*
    Development-only reference for the theme (ADR-015). Everything here is plain markup
    using the same classes pages use, so if it looks right here it looks right everywhere.
    Use the navbar toggle to check both modes; the token section shows both side by side.
*@
<div class="container">
    <div class="hgd-page-header">
        <div>
            <span class="hgd-eyebrow">Development only</span>
            <h1>Style guide</h1>
        </div>
        <p class="text-secondary mb-0">Neon Yellow + Obsidian · tokens in <code>wwwroot/css/site.css</code></p>
    </div>

    @* ---- Tokens ---------------------------------------------------------------- *@
    <section class="mb-5">
        <h2 class="h4 mb-3">Colour tokens</h2>
        <div class="row g-4">
            @foreach (var mode in new[] { "light", "dark" })
            {
                <div class="col-lg-6" data-bs-theme="@mode">
                    <div class="card">
                        <div class="card-body">
                            <h3 class="h6 text-uppercase text-secondary mb-3">@mode</h3>
                            <div class="row g-3 row-cols-2 row-cols-sm-4">
                                <div><div class="hgd-swatch" style="background: var(--hgd-bg)"></div><small class="text-secondary">--hgd-bg</small></div>
                                <div><div class="hgd-swatch" style="background: var(--hgd-surface)"></div><small class="text-secondary">--hgd-surface</small></div>
                                <div><div class="hgd-swatch" style="background: var(--hgd-surface-elevated); box-shadow: var(--hgd-shadow)"></div><small class="text-secondary">--hgd-surface-elevated</small></div>
                                <div><div class="hgd-swatch" style="background: var(--hgd-surface-muted)"></div><small class="text-secondary">--hgd-surface-muted</small></div>
                                <div><div class="hgd-swatch" style="background: var(--hgd-primary)"></div><small class="text-secondary">--hgd-primary</small></div>
                                <div><div class="hgd-swatch" style="background: var(--hgd-primary-text)"></div><small class="text-secondary">--hgd-primary-text</small></div>
                                <div><div class="hgd-swatch" style="background: var(--hgd-text)"></div><small class="text-secondary">--hgd-text</small></div>
                                <div><div class="hgd-swatch" style="background: var(--hgd-text-secondary)"></div><small class="text-secondary">--hgd-text-secondary</small></div>
                            </div>
                            <p class="mt-3 mb-0 small text-secondary">
                                Body text, <a href="#">a link</a>, <span style="color: var(--hgd-primary-text)">accent text</span>
                                and a <span class="badge text-bg-primary">primary badge</span>.
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
        <p class="small text-secondary mt-3 mb-0">
            Yellow is a <em>fill</em> colour: always put dark text on it. As <em>text</em> use <code>--hgd-primary-text</code>
            (amber in light mode, yellow in dark) so links and accents stay readable.
        </p>
    </section>

    @* ---- Typography ------------------------------------------------------------- *@
    <section class="mb-5">
        <h2 class="h4 mb-3">Typography</h2>
        <div class="card">
            <div class="card-body">
                <span class="hgd-eyebrow">Eyebrow · Space Grotesk 600</span>
                <h1 class="mt-2">Heading 1 · Space Grotesk 700</h1>
                <h2>Heading 2 · ship it</h2>
                <h3>Heading 3 · Unity, Unreal, Godot</h3>
                <h4>Heading 4 · Senior Gameplay Programmer</h4>
                <p class="lead">Lead paragraph · Inter 400. Studios post roles with real salary ranges.</p>
                <p>Body · Inter 400 at 16px. Programmers, artists, designers, QA, producers, audio — show your shipped work and find studios that pay fairly. <a href="#">Inline link</a>, <strong>bold</strong>, <code>code</code>.</p>
                <p class="small text-secondary mb-0">Small secondary text · 14px for metadata such as "Posted 2 days ago · Bengaluru".</p>
            </div>
        </div>
    </section>

    @* ---- Buttons ---------------------------------------------------------------- *@
    <section class="mb-5">
        <h2 class="h4 mb-3">Buttons</h2>
        <div class="card">
            <div class="card-body d-flex flex-column gap-3">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <button type="button" class="btn btn-primary">Primary</button>
                    <button type="button" class="btn btn-outline-primary">Outline primary</button>
                    <button type="button" class="btn btn-outline-secondary">Secondary</button>
                    <button type="button" class="btn btn-link">Link button</button>
                    <button type="button" class="btn btn-primary" disabled>Disabled</button>
                </div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <button type="button" class="btn btn-primary btn-lg d-inline-flex align-items-center gap-2">
                        Apply now <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-arrow-right" /></svg>
                    </button>
                    <button type="button" class="btn btn-primary">Default</button>
                    <button type="button" class="btn btn-primary btn-sm">Small</button>
                    <button type="button" class="btn hgd-icon-btn" aria-label="Icon button">
                        <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-search" /></svg>
                    </button>
                </div>
                <div class="d-flex flex-wrap gap-2" style="max-width: 28rem">
                    <button type="button" class="btn btn-lg hgd-provider-btn flex-fill">
                        <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-google" /></svg> <span>Continue with Google</span>
                    </button>
                    <button type="button" class="btn btn-lg hgd-provider-btn flex-fill">
                        <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-github" /></svg> <span>Continue with GitHub</span>
                    </button>
                </div>
            </div>
        </div>
    </section>

    @* ---- Badges ----------------------------------------------------------------- *@
    <section class="mb-5">
        <h2 class="h4 mb-3">Badges &amp; status</h2>
        <div class="card">
            <div class="card-body">
                <p class="small text-secondary">Application pipeline (used on dashboards and application lists):</p>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span class="hgd-badge hgd-badge-neutral">Draft</span>
                    <span class="hgd-badge hgd-badge-info">Applied</span>
                    <span class="hgd-badge hgd-badge-primary">Shortlisted</span>
                    <span class="hgd-badge hgd-badge-warning">Interview</span>
                    <span class="hgd-badge hgd-badge-success">Offer</span>
                    <span class="hgd-badge hgd-badge-danger">Rejected</span>
                </div>
                <p class="small text-secondary">Plain tags (skills, engines, job type):</p>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge text-bg-primary">Featured</span>
                    <span class="badge bg-primary-subtle text-primary-emphasis">Unity</span>
                    <span class="badge bg-primary-subtle text-primary-emphasis">C#</span>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis">Remote</span>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis">Full-time</span>
                    <span class="badge bg-success-subtle text-success-emphasis">Verified studio</span>
                </div>
            </div>
        </div>
    </section>

    @* ---- Forms ------------------------------------------------------------------ *@
    <section class="mb-5">
        <h2 class="h4 mb-3">Forms</h2>
        <div class="card">
            <div class="card-body">
                <form class="row g-3" onsubmit="return false">
                    <div class="col-md-6">
                        <label class="form-label" for="sgTitle">Job title</label>
                        <input type="text" class="form-control" id="sgTitle" placeholder="Senior Gameplay Programmer" />
                        <div class="form-text">Shown in search results.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="sgEngine">Engine</label>
                        <select class="form-select" id="sgEngine">
                            <option>Unity</option>
                            <option>Unreal Engine</option>
                            <option>Godot</option>
                            <option>Custom</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="sgSalary">Salary (per year, INR)</label>
                        <div class="input-group">
                            <span class="input-group-text">&#8377;</span>
                            <input type="text" class="form-control is-invalid" id="sgSalary" value="abc" />
                            <div class="invalid-feedback">Enter a number, e.g. 1800000.</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="sgCity">City</label>
                        <input type="text" class="form-control is-valid" id="sgCity" value="Hyderabad" />
                        <div class="valid-feedback">Looks good.</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="sgAbout">About the role</label>
                        <textarea class="form-control" id="sgAbout" rows="3" placeholder="What will this person ship in their first six months?"></textarea>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check"><input class="form-check-input" type="checkbox" id="sgRemote" checked /><label class="form-check-label" for="sgRemote">Remote friendly</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" id="sgRelocate" /><label class="form-check-label" for="sgRelocate">Relocation support</label></div>
                        <div class="form-check form-switch"><input class="form-check-input" type="checkbox" role="switch" id="sgOpen" checked /><label class="form-check-label" for="sgOpen">Open to work</label></div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-grid gap-2">
                            <label class="hgd-choice">
                                <input class="form-check-input" type="radio" name="sgType" id="sgTypeFull" checked />
                                <span><strong class="d-block">Full-time</strong><span class="text-secondary small">Permanent role</span></span>
                            </label>
                            <label class="hgd-choice">
                                <input class="form-check-input" type="radio" name="sgType" id="sgTypeContract" />
                                <span><strong class="d-block">Contract</strong><span class="text-secondary small">Fixed term</span></span>
                            </label>
                        </div>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Publish job</button>
                        <button type="button" class="btn btn-outline-secondary">Save draft</button>
                    </div>
                </form>
            </div>
        </div>
    </section>

    @* ---- Cards ------------------------------------------------------------------ *@
    <section class="mb-5">
        <h2 class="h4 mb-3">Cards</h2>
        <div class="row g-4">
            <div class="col-md-6 col-xl-4">
                <a class="hgd-card-link" href="#">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                <span class="hgd-tile" aria-hidden="true"><svg class="hgd-icon"><use href="#hgd-icon-briefcase" /></svg></span>
                                <span class="hgd-badge hgd-badge-success">&#8377;18–28 LPA</span>
                            </div>
                            <h3 class="h5 card-title mb-1">Senior Gameplay Programmer</h3>
                            <p class="text-secondary small mb-3">Northstar Games · Pune · Hybrid</p>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <span class="badge bg-primary-subtle text-primary-emphasis">Unreal</span>
                                <span class="badge bg-primary-subtle text-primary-emphasis">C++</span>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">5+ yrs</span>
                            </div>
                            <p class="small text-secondary mb-0">Posted 2 days ago · 14 applicants</p>
                        </div>
                    </div>
                </a>
                <p class="small text-secondary mt-2 mb-0">Job card · <code>.card</code> inside <code>.hgd-card-link</code> (lifts on hover)</p>
            </div>
            <div class="col-md-6 col-xl-4">
                <div class="card hgd-elevated h-100">
                    <div class="card-body">
                        <h3 class="h5 card-title">Elevated card</h3>
                        <p class="text-secondary">Primary panel of a page: auth forms, the main dashboard card. White or charcoal with a soft shadow.</p>
                        <div class="d-flex gap-4">
                            <div><div class="hgd-stat">12</div><small class="text-secondary">Applications</small></div>
                            <div><div class="hgd-stat">3</div><small class="text-secondary">Interviews</small></div>
                            <div><div class="hgd-stat">1</div><small class="text-secondary">Offer</small></div>
                        </div>
                    </div>
                </div>
                <p class="small text-secondary mt-2 mb-0"><code>.card.hgd-elevated</code> + <code>.hgd-stat</code></p>
            </div>
            <div class="col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-header fw-semibold">Studio profile</div>
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <span class="hgd-tile" aria-hidden="true"><svg class="hgd-icon"><use href="#hgd-icon-map-pin" /></svg></span>
                            <div>
                                <div class="fw-semibold">Pixel Forge Studios</div>
                                <div class="small text-secondary">Pune · 50–200 people</div>
                            </div>
                        </div>
                        <p class="text-secondary small mb-0">Mobile shooters and real-time multiplayer for India-first audiences.</p>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <span class="hgd-badge hgd-badge-success">Verified</span>
                        <a href="#" class="small">4 open roles</a>
                    </div>
                </div>
                <p class="small text-secondary mt-2 mb-0">Header / footer card</p>
            </div>
        </div>
    </section>

    @* ---- Table ------------------------------------------------------------------ *@
    <section class="mb-5">
        <h2 class="h4 mb-3">Table</h2>
        <div class="card hgd-table-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr><th>Applicant</th><th>Role</th><th>Experience</th><th>Status</th><th class="text-end">Applied</th></tr>
                    </thead>
                    <tbody>
                        <tr><td class="fw-semibold">Ananya Rao</td><td>Senior Gameplay Programmer</td><td>7 yrs · Unreal</td><td><span class="hgd-badge hgd-badge-warning">Interview</span></td><td class="text-end text-secondary">2 d ago</td></tr>
                        <tr><td class="fw-semibold">Rohan Mehta</td><td>Technical Artist</td><td>4 yrs · Unity</td><td><span class="hgd-badge hgd-badge-primary">Shortlisted</span></td><td class="text-end text-secondary">3 d ago</td></tr>
                        <tr><td class="fw-semibold">Priya Nair</td><td>QA Lead</td><td>6 yrs</td><td><span class="hgd-badge hgd-badge-info">Applied</span></td><td class="text-end text-secondary">5 d ago</td></tr>
                        <tr><td class="fw-semibold">Arjun Singh</td><td>Level Designer</td><td>3 yrs · Godot</td><td><span class="hgd-badge hgd-badge-danger">Rejected</span></td><td class="text-end text-secondary">1 w ago</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    @* ---- Alerts ----------------------------------------------------------------- *@
    <section class="mb-5">
        <h2 class="h4 mb-3">Alerts</h2>
        <div class="alert alert-success" role="alert">Application sent. The studio will see it in their dashboard.</div>
        <div class="alert alert-info" role="alert">Your profile is 60% complete — add a shipped title to rank higher.</div>
        <div class="alert alert-warning" role="alert">No sign-in provider is configured. Add Google or GitHub credentials.</div>
        <div class="alert alert-danger mb-0" role="alert">Sign-in with GitHub was cancelled or failed. Please try again.</div>
    </section>
</div>
