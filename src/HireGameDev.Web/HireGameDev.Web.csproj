<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.GitHub" Version="9.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="9.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HireGameDev.Application\HireGameDev.Application.csproj" />
    <ProjectReference Include="..\HireGameDev.Infrastructure\HireGameDev.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Local secrets (OAuth client ids, connection string) live in `dotnet user-secrets`, never in appsettings. -->
    <UserSecretsId>hiregamedev-web-6f1f3c2e-2c1b-4f0e-9a0e-3b9d7f1d8a21</UserSecretsId>
  </PropertyGroup>

</Project>
