@using HireGameDev.Domain.Enums
@*
    The two ways into the product. Used by the landing page and by /Account/SignUp
    when no role was chosen yet. The whole card is clickable (stretched-link).
*@
<div class="row g-4 justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card h-100 hgd-interactive">
            <div class="card-body d-flex flex-column">
                <span class="hgd-tile mb-3" aria-hidden="true">
                    <svg class="hgd-icon"><use href="#hgd-icon-user" /></svg>
                </span>
                <h2 class="h4 card-title">I'm a game developer</h2>
                <p class="text-secondary flex-grow-1">
                    Programmers, artists, designers, QA, producers, audio — show your shipped work
                    and find studios that pay fairly.
                </p>
                <a class="btn btn-primary stretched-link" asp-controller="Account" asp-action="SignUp" asp-route-role="@UserRole.Candidate">Find game jobs</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-5">
        <div class="card h-100 hgd-interactive">
            <div class="card-body d-flex flex-column">
                <span class="hgd-tile mb-3" aria-hidden="true">
                    <svg class="hgd-icon"><use href="#hgd-icon-briefcase" /></svg>
                </span>
                <h2 class="h4 card-title">I'm a studio</h2>
                <p class="text-secondary flex-grow-1">
                    Post roles with salary ranges, see ranked applicants and hire from India's game talent pool.
                </p>
                <a class="btn btn-outline-primary stretched-link" asp-controller="Account" asp-action="SignUp" asp-route-role="@UserRole.Studio">Hire game talent</a>
            </div>
        </div>
    </div>
</div>
