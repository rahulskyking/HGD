<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <title>@ViewData["Title"] - HireGameDev</title>

    <script>
        // Apply the saved colour theme before first paint so there is no flash.
        // The switcher itself lives in js/site.js (ADR-015).
        (function () {
            try {
                var theme = localStorage.getItem("hgd-theme");
                if (theme !== "light" && theme !== "dark") {
                    theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                }
                document.documentElement.setAttribute("data-bs-theme", theme);
            } catch (e) { }
        })();
    </script>

    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />

    <link rel="preload" href="~/fonts/inter/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/space-grotesk/space-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <partial name="_IconSpritePartial" />

    <header class="hgd-header">
        <nav class="navbar navbar-expand-md hgd-navbar" aria-label="Main">
            <div class="container">
                <a class="navbar-brand hgd-brand" asp-controller="Home" asp-action="Index">
                    <span class="hgd-brand-mark" aria-hidden="true">
                        <svg><use href="#hgd-icon-logo" /></svg>
                    </span>
                    <span>Hire<span class="hgd-brand-accent">Game</span>Dev</span>
                </a>

                <div class="d-flex align-items-center gap-1 order-md-last">
                    <partial name="_ThemeTogglePartial" />
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <div class="navbar-collapse collapse justify-content-end" id="mainNav">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" id="main">
        @RenderBody()
    </main>

    @* The footer stays obsidian in both modes: it carries its own colour mode. *@
    <footer class="hgd-footer" data-bs-theme="dark">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="hgd-brand-mark" aria-hidden="true">
                    <svg><use href="#hgd-icon-logo" /></svg>
                </span>
                <span>&copy; 2026 HireGameDev</span>
            </div>
            <ul class="list-inline mb-0">
                <li class="list-inline-item"><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
            </ul>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/forms.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
