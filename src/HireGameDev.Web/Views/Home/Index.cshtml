@using HireGameDev.Domain.Enums
@{
    ViewData["Title"] = "Game industry hiring, built for India";
}

@* Hero is obsidian in both modes: it carries its own colour mode. *@
<section class="hgd-hero" data-bs-theme="dark">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="hgd-eyebrow mb-3">India's game-industry job board</span>
                <h1 class="mb-3">Game industry hiring, <span class="hgd-highlight">built for India</span>.</h1>
                <p class="lead mb-4">
                    Studios post roles with real salary ranges. Developers show real shipped work.
                    Everyone can see where their application stands.
                </p>
                <div class="d-flex flex-column flex-sm-row gap-2">
                    <a class="btn btn-primary btn-lg d-inline-flex align-items-center justify-content-center gap-2"
                       asp-controller="Account" asp-action="SignUp" asp-route-role="@UserRole.Candidate">
                        Find game jobs <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-arrow-right" /></svg>
                    </a>
                    <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="SignUp" asp-route-role="@UserRole.Studio">Hire game talent</a>
                </div>
                <p class="small text-secondary mt-3 mb-0">Free for developers. Sign in with Google or GitHub.</p>
            </div>

            @* Illustrative only: what a job and its application pipeline look like in the product. *@
            <div class="col-lg-5 d-none d-lg-block" aria-hidden="true">
                <div class="card hgd-hero-preview ms-lg-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <span class="hgd-tile"><svg class="hgd-icon"><use href="#hgd-icon-briefcase" /></svg></span>
                            <span class="hgd-badge hgd-badge-success">&#8377;18–28 LPA</span>
                        </div>
                        <h2 class="h5 card-title mb-1">Senior Gameplay Programmer</h2>
                        <p class="text-secondary small mb-3">Northstar Games · Pune · Hybrid</p>
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            <span class="badge bg-primary-subtle text-primary-emphasis">Unreal</span>
                            <span class="badge bg-primary-subtle text-primary-emphasis">C++</span>
                            <span class="badge bg-secondary-subtle text-secondary-emphasis">5+ yrs</span>
                        </div>
                        <ol class="hgd-steps">
                            <li class="is-done">Applied</li>
                            <li class="is-done">Shortlisted</li>
                            <li class="is-current">Interview</li>
                            <li>Offer</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="hgd-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <span class="hgd-tile mb-3" aria-hidden="true">
                    <svg class="hgd-icon"><use href="#hgd-icon-trending-up" /></svg>
                </span>
                <h2 class="h5">A salary range on every job</h2>
                <p class="text-secondary mb-0">No "competitive". Every role lists a real range, so you know before you apply.</p>
            </div>
            <div class="col-md-4">
                <span class="hgd-tile mb-3" aria-hidden="true">
                    <svg class="hgd-icon"><use href="#hgd-icon-check-circle" /></svg>
                </span>
                <h2 class="h5">Shipped work, front and centre</h2>
                <p class="text-secondary mb-0">Profiles are built around shipped titles and what you actually did on them.</p>
            </div>
            <div class="col-md-4">
                <span class="hgd-tile mb-3" aria-hidden="true">
                    <svg class="hgd-icon"><use href="#hgd-icon-eye" /></svg>
                </span>
                <h2 class="h5">Know where you stand</h2>
                <p class="text-secondary mb-0">Every application has a visible status, from applied through to offer.</p>
            </div>
        </div>
    </div>
</section>

<section class="hgd-section pt-0">
    <div class="container">
        <div class="text-center mb-4">
            <span class="hgd-eyebrow">Get started</span>
            <h2 class="hgd-section-title mb-0">Who are you?</h2>
        </div>

        <partial name="_JoinOptionsPartial" />

        <p class="text-center text-secondary mt-4 mb-0">
            Already have an account? <a asp-controller="Account" asp-action="Login">Sign in</a>
        </p>
    </div>
</section>
