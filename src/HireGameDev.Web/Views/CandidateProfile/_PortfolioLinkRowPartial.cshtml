@model PortfolioLinkInput
@* One repeater row; see _ShippedTitleRowPartial for how the template copy is produced. *@
<div class="hgd-repeater-row" data-hgd-repeater-row>
    <div class="row g-3 flex-grow-1">
        <div class="col-md-7">
            <label asp-for="Url" class="form-label"></label>
            <input asp-for="Url" class="form-control" type="url" inputmode="url" placeholder="https://www.artstation.com/you" />
            <span asp-validation-for="Url" class="text-danger small"></span>
        </div>
        <div class="col-md-5">
            <label asp-for="Label" class="form-label"></label>
            <input asp-for="Label" class="form-control" placeholder="ArtStation" />
            <span asp-validation-for="Label" class="text-danger small"></span>
        </div>
    </div>
    <button type="button" class="btn hgd-icon-btn" data-hgd-repeater-remove aria-label="Remove this link" title="Remove">
        <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-trash-2" /></svg>
    </button>
</div>
