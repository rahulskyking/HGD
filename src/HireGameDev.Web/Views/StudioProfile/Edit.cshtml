@using HireGameDev.Domain.Entities
@using HireGameDev.Domain.Enums
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model StudioProfileEditViewModel
@{
    ViewData["Title"] = Model.IsNew ? "Create your studio profile" : "Edit your studio profile";

    var gameTemplate = new ViewDataDictionary<StudioGameInput>(ViewData, new StudioGameInput())
    {
        TemplateInfo = { HtmlFieldPrefix = "Input.Games[__index__]" },
    };
    var logo = new StudioLogo(
        string.IsNullOrWhiteSpace(Model.Input.Name) ? "Your studio" : Model.Input.Name,
        Model.LogoUrl,
        StudioLogo.Size.Large);
    var enginePicker = new SkillPicker(
        "Input.EngineIds",
        Model.Engines,
        Model.Input.EngineIds,
        0,
        StudioProfile.MaximumEngines);
    var selectedCity = IndianCity.Find(Model.Input.City);
}

<div class="container">
    <div class="hgd-page-header">
        <div>
            <span class="hgd-eyebrow">Studio profile</span>
            <h1>@ViewData["Title"]</h1>
            <p class="text-secondary mb-0">Give developers a clear, honest picture of your team and the games you make.</p>
        </div>
        @if (!Model.IsNew)
        {
            <a class="btn btn-outline-secondary" asp-controller="StudioProfile" asp-action="Index">Back to profile</a>
        }
    </div>

    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2" role="status">
            <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-check-circle" /></svg>
            <span>@Model.StatusMessage</span>
        </div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
            <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-alert-triangle" /></svg>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8 d-flex flex-column gap-4">
            @* The logo is separate from the profile save and needs a saved StudioProfile. *@
            <section class="card" id="logo">
                <div class="card-body d-flex flex-column flex-sm-row gap-3 align-items-sm-center">
                    <partial name="_StudioLogoPartial" model="logo" />
                    <div class="flex-grow-1">
                        <h2 class="h5 card-title mb-1">Studio logo</h2>
                        @if (Model.IsNew)
                        {
                            <p class="text-secondary mb-0">Save your profile first, then upload a logo here.</p>
                        }
                        else
                        {
                            <p class="text-secondary small mb-2">Square JPEG, PNG or WebP up to 2 MB. A simple mark stays clear at every size.</p>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <form method="post" enctype="multipart/form-data" asp-controller="StudioProfile" asp-action="UploadLogo" class="d-flex flex-wrap gap-2 align-items-center">
                                    <input type="file" class="form-control form-control-sm w-auto" asp-for="Logo" accept="image/jpeg,image/png,image/webp" required />
                                    <button type="submit" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-2">
                                        <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-image" /></svg> Upload logo
                                    </button>
                                </form>
                                @if (Model.LogoUrl is not null)
                                {
                                    <form method="post" asp-controller="StudioProfile" asp-action="RemoveLogo">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2">
                                            <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-trash-2" /></svg> Remove
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>

            <form method="post" asp-controller="StudioProfile" asp-action="Edit" id="studio-profile-form" class="d-flex flex-column gap-4" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <section class="card" id="basics">
                    <div class="card-body">
                        <h2 class="h5 card-title mb-1">The essentials</h2>
                        <p class="text-secondary small mb-3">A few details help developers understand who is hiring.</p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.Name" class="form-label"></label>
                                <input asp-for="Input.Name" class="form-control" autocomplete="organization" placeholder="Nodding Heads Games" />
                                <span asp-validation-for="Input.Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.WebsiteUrl" class="form-label"></label>
                                <input asp-for="Input.WebsiteUrl" class="form-control" type="url" placeholder="https://yourstudio.in" autocomplete="url" />
                                <span asp-validation-for="Input.WebsiteUrl" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.City" class="form-label"></label>
                                <select asp-for="Input.City" class="form-select" data-hgd-city-state="#studio-state">
                                    <option value="">Choose a city…</option>
                                    @foreach (var city in IndianCity.All.OrderBy(x => x.Name))
                                    {
                                        <option value="@city.Name" data-state="@city.State">@city.Name, @city.State</option>
                                    }
                                </select>
                                <div class="form-text">State: <strong id="studio-state" data-hgd-city-state-output>@(selectedCity?.State ?? "Choose a city")</strong></div>
                                <span asp-validation-for="Input.City" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Input.Size" class="form-label"></label>
                                <select asp-for="Input.Size" asp-items="EnumDisplay.StudioSizes()" class="form-select">
                                    <option value="">Choose…</option>
                                </select>
                                <span asp-validation-for="Input.Size" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Input.Type" class="form-label"></label>
                                <select asp-for="Input.Type" asp-items="EnumDisplay.StudioTypes()" class="form-select">
                                    <option value="">Choose…</option>
                                </select>
                                <span asp-validation-for="Input.Type" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.About" class="form-label"></label>
                                <textarea asp-for="Input.About" class="form-control" rows="4" maxlength="@StudioProfile.AboutMaxLength"
                                          placeholder="What do you make? What is it like to build games with your team?"></textarea>
                                <div class="form-text d-flex justify-content-between">
                                    <span>Keep it specific and human.</span>
                                    <span><span data-hgd-charcount-for="Input_About">@(Model.Input.About?.Length ?? 0)</span>/@StudioProfile.AboutMaxLength</span>
                                </div>
                                <span asp-validation-for="Input.About" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="card" id="engines">
                    <div class="card-body">
                        <h2 class="h5 card-title mb-1">Engines</h2>
                        <p class="text-secondary small mb-3">Which engines does your team ship games with? Select from the shared master list.</p>
                        <span asp-validation-for="Input.EngineIds" class="text-danger small d-block mb-2"></span>
                        <partial name="_SkillPickerPartial" model="enginePicker" />
                    </div>
                </section>

                <section class="card" id="genres">
                    <div class="card-body">
                        <h2 class="h5 card-title mb-1">Genres</h2>
                        <p class="text-secondary small mb-2">Choose the kinds of games your studio makes.</p>
                        <p class="small text-secondary">Selected: <strong data-hgd-checked-count data-hgd-checked-count-for="Input.Genres">@Model.Input.Genres.Count</strong></p>
                        <span asp-validation-for="Input.Genres" class="text-danger small d-block mb-2"></span>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var genre in Enum.GetValues<GameGenre>())
                            {
                                var id = $"studio-genre-{genre}";
                                <span>
                                    <input type="checkbox" class="btn-check" id="@id" name="Input.Genres" value="@genre"
                                           autocomplete="off" checked="@Model.Input.Genres.Contains(genre)" />
                                    <label class="hgd-chip" for="@id">@EnumDisplay.Name(genre)</label>
                                </span>
                            }
                        </div>
                    </div>
                </section>

                <section class="card" id="culture">
                    <div class="card-body">
                        <h2 class="h5 card-title mb-1">Culture &amp; benefits</h2>
                        <p class="text-secondary small mb-2">Tell candidates how your team works. Select only what you can stand behind.</p>
                        <p class="small text-secondary">Selected: <strong data-hgd-checked-count data-hgd-checked-count-for="Input.CultureTags">@Model.Input.CultureTags.Count</strong></p>
                        <span asp-validation-for="Input.CultureTags" class="text-danger small d-block mb-2"></span>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var tag in Enum.GetValues<CultureTag>())
                            {
                                var id = $"studio-culture-{tag}";
                                <span>
                                    <input type="checkbox" class="btn-check" id="@id" name="Input.CultureTags" value="@tag"
                                           autocomplete="off" checked="@Model.Input.CultureTags.Contains(tag)" />
                                    <label class="hgd-chip" for="@id">@EnumDisplay.Name(tag)</label>
                                </span>
                            }
                        </div>
                    </div>
                </section>

                <section class="card" id="games">
                    <div class="card-body">
                        <h2 class="h5 card-title mb-1">Released games</h2>
                        <p class="text-secondary small mb-3">Games your team has shipped. Add a store page or trailer if you have one — up to @StudioProfile.MaximumGames.</p>
                        <span asp-validation-for="Input.Games" class="text-danger small d-block mb-2"></span>
                        <div data-hgd-repeater data-hgd-repeater-prefix="Input.Games" data-hgd-repeater-max="@StudioProfile.MaximumGames">
                            <div class="d-flex flex-column gap-3" data-hgd-repeater-rows>
                                @for (var i = 0; i < Model.Input.Games.Count; i++)
                                {
                                    <partial name="_StudioGameRowPartial" for="Input.Games[i]" />
                                }
                            </div>
                            <template data-hgd-repeater-template>
                                <partial name="_StudioGameRowPartial" model="gameTemplate.Model" view-data="gameTemplate" />
                            </template>
                            <p class="text-secondary small mb-0 mt-2 @(Model.Input.Games.Count > 0 ? "d-none" : "")" data-hgd-repeater-empty>
                                No released games listed yet.
                            </p>
                            <button type="button" class="btn btn-outline-primary btn-sm mt-3 d-inline-flex align-items-center gap-2" data-hgd-repeater-add>
                                <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-plus" /></svg> Add a game
                            </button>
                        </div>
                    </div>
                </section>

                <section class="card" id="gst">
                    <div class="card-body">
                        <h2 class="h5 card-title mb-1">Billing details</h2>
                        <p class="text-secondary small mb-3">GSTIN is optional. It is stored for future invoicing and is never shown on a public studio profile.</p>
                        <label asp-for="Input.GstNumber" class="form-label"></label>
                        <input asp-for="Input.GstNumber" class="form-control text-uppercase" style="max-width: 24rem" placeholder="29ABCDE1234F1Z5" autocomplete="off" />
                        <span asp-validation-for="Input.GstNumber" class="text-danger small"></span>
                    </div>
                </section>

                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <button type="submit" class="btn btn-primary btn-lg">@(Model.IsNew ? "Create studio profile" : "Save changes")</button>
                    @if (!Model.IsNew)
                    {
                        <a class="btn btn-link" asp-controller="StudioProfile" asp-action="Index">Cancel</a>
                    }
                </div>
            </form>
        </div>

        <aside class="col-lg-4">
            <div class="card hgd-sticky-aside">
                <div class="card-body">
                    <h2 class="h6 text-uppercase text-secondary mb-3">On this page</h2>
                    <nav class="nav flex-column gap-1 mb-4" aria-label="Form sections">
                        <a class="nav-link px-0 py-1" href="#basics">The essentials</a>
                        <a class="nav-link px-0 py-1" href="#engines">Engines</a>
                        <a class="nav-link px-0 py-1" href="#genres">Genres</a>
                        <a class="nav-link px-0 py-1" href="#culture">Culture &amp; benefits</a>
                        <a class="nav-link px-0 py-1" href="#games">Released games</a>
                        <a class="nav-link px-0 py-1" href="#gst">Billing details</a>
                    </nav>
                    <h2 class="h6 text-uppercase text-secondary mb-2">Build trust</h2>
                    <ul class="small text-secondary ps-3 mb-0 d-flex flex-column gap-2">
                        <li>Keep your studio name, website and location current.</li>
                        <li>Culture tags are commitments — choose only what is true for your team.</li>
                        <li>Show released work so developers know what they may help build next.</li>
                    </ul>
                </div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
