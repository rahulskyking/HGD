@using HireGameDev.Domain.Enums
@model StudioProfileViewModel
@{
    ViewData["Title"] = Model.Profile.Name;
    var profile = Model.Profile;
}

<div class="container">
    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mt-3" role="status">
            <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-check-circle" /></svg>
            <span>@Model.StatusMessage</span>
        </div>
    }

    <div class="hgd-page-header">
        <div class="d-flex gap-3 align-items-center">
            <partial name="_StudioLogoPartial" model="new StudioLogo(profile.Name, profile.LogoUrl, StudioLogo.Size.Large)" />
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <h1>@profile.Name</h1>
                    @if (profile.IsVerified)
                    {
                        <span class="hgd-badge hgd-badge-success d-inline-flex align-items-center gap-1">
                            <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-shield" /></svg> Verified
                        </span>
                    }
                </div>
                <p class="text-secondary mb-0 d-flex flex-wrap gap-3">
                    <span class="d-inline-flex align-items-center gap-1">
                        <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-map-pin" /></svg>@profile.City, @profile.State
                    </span>
                    <span>@EnumDisplay.Name(profile.Size)</span>
                    <span>@EnumDisplay.Name(profile.Type)</span>
                </p>
            </div>
        </div>
        <a class="btn btn-primary d-inline-flex align-items-center gap-2" asp-controller="StudioProfile" asp-action="Edit">
            <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-edit-2" /></svg> Edit profile
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8 d-flex flex-column gap-4">
            <section class="card">
                <div class="card-body">
                    <h2 class="h5 card-title">About the studio</h2>
                    @if (profile.About is null)
                    {
                        <p class="text-secondary mb-0">Add a short introduction so developers know what your team is about. <a asp-controller="StudioProfile" asp-action="Edit" asp-fragment="basics">Write your About</a>.</p>
                    }
                    else
                    {
                        <p class="mb-0" style="white-space: pre-line">@profile.About</p>
                    }
                </div>
            </section>

            <section class="card">
                <div class="card-body">
                    <h2 class="h5 card-title d-flex align-items-center gap-2">
                        <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-layers" /></svg> Engines
                    </h2>
                    @if (profile.Engines.Count == 0)
                    {
                        <p class="text-secondary mb-0">No engines listed yet. <a asp-controller="StudioProfile" asp-action="Edit" asp-fragment="engines">Add your engines</a>.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled d-flex flex-wrap gap-2 mb-0">
                            @foreach (var engine in profile.Engines)
                            {
                                <li class="hgd-chip hgd-chip-static">@engine.Name</li>
                            }
                        </ul>
                    }
                </div>
            </section>

            <section class="card">
                <div class="card-body">
                    <h2 class="h5 card-title d-flex align-items-center gap-2">
                        <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-grid" /></svg> Genres
                    </h2>
                    @if (profile.Genres.Count == 0)
                    {
                        <p class="text-secondary mb-0">No genres listed yet. <a asp-controller="StudioProfile" asp-action="Edit" asp-fragment="genres">Add your genres</a>.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled d-flex flex-wrap gap-2 mb-0">
                            @foreach (var genre in profile.Genres)
                            {
                                <li class="hgd-chip hgd-chip-static">@EnumDisplay.Name(genre)</li>
                            }
                        </ul>
                    }
                </div>
            </section>

            <section class="card">
                <div class="card-body">
                    <h2 class="h5 card-title d-flex align-items-center gap-2">
                        <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-award" /></svg> Released games
                    </h2>
                    @if (profile.Games.Count == 0)
                    {
                        <p class="text-secondary mb-0">No released games listed yet. <a asp-controller="StudioProfile" asp-action="Edit" asp-fragment="games">Add a game</a>.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled d-flex flex-column gap-3 mb-0">
                            @foreach (var game in profile.Games)
                            {
                                <li class="d-flex gap-3">
                                    <span class="hgd-year">@game.Year</span>
                                    <div class="flex-grow-1">
                                        <strong class="d-block">@game.Name</strong>
                                        @if (game.Url is not null)
                                        {
                                            <a class="small" href="@game.Url" target="_blank" rel="noopener noreferrer nofollow">
                                                <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-external-link" /></svg>
                                                @PortfolioHost.Label(game.Url, null)
                                            </a>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>

            <section class="card">
                <div class="card-body">
                    <h2 class="h5 card-title d-flex align-items-center gap-2">
                        <svg class="hgd-icon" aria-hidden="true"><use href="#hgd-icon-heart" /></svg> Culture &amp; benefits
                    </h2>
                    @if (profile.CultureTags.Count == 0)
                    {
                        <p class="text-secondary mb-0">No culture tags listed yet. <a asp-controller="StudioProfile" asp-action="Edit" asp-fragment="culture">Tell developers how your team works</a>.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled d-flex flex-wrap gap-2 mb-0">
                            @foreach (var tag in profile.CultureTags)
                            {
                                <li class="hgd-chip hgd-chip-static">@EnumDisplay.Name(tag)</li>
                            }
                        </ul>
                    }
                </div>
            </section>
        </div>

        <aside class="col-lg-4 d-flex flex-column gap-4">
            <section class="card">
                <div class="card-body">
                    <h2 class="h6 text-uppercase text-secondary mb-3">Studio details</h2>
                    <dl class="hgd-details mb-0">
                        <dt>Location</dt>
                        <dd>@profile.City, @profile.State</dd>
                        <dt>Team size</dt>
                        <dd>@EnumDisplay.Name(profile.Size)</dd>
                        <dt>Studio type</dt>
                        <dd>@EnumDisplay.Name(profile.Type)</dd>
                        @if (profile.WebsiteUrl is not null)
                        {
                            <dt>Website</dt>
                            <dd><a href="@profile.WebsiteUrl" target="_blank" rel="noopener noreferrer">@PortfolioHost.Label(profile.WebsiteUrl, null)</a></dd>
                        }
                    </dl>
                </div>
            </section>

            <section class="card hgd-elevated">
                <div class="card-body">
                    <h2 class="h5 card-title">Ready to hire?</h2>
                    <p class="text-secondary">Create drafts, publish roles with an expiry date, and manage your active job posts.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary" asp-controller="StudioJobs" asp-action="Create">Post a job</a>
                        <a class="btn btn-outline-secondary" asp-controller="StudioJobs" asp-action="Index">Manage job posts</a>
                    </div>
                </div>
            </section>

            <p class="small text-secondary mb-0">Last updated @profile.LastChangedAtUtc.ToString("d MMM yyyy") (UTC).</p>
        </aside>
    </div>
</div>
